{
  "expo": {
    "name": "HelioCore AI",
    "slug": "heliocore-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "heliocore",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c10"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.heliocore.mobile"
    },
    "android": {
      "package": "ai.heliocore.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080c10"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
